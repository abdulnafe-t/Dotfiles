// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 5, // Gaps between modules (4px)
    // Choose the order of the modules
    "margin": 0,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
	"mpris",
        "wireplumber",
	"network",
	"bluetooth",
	"power-profiles-daemon",
        "tray",
        "custom/power"
    ],
    "tray": {
    },
    "wireplumber": {
	"format": "{icon}  {volume}%",
	"format-muted": "󰸈",
	"format-icons": ["", "", ""],
	"states":{
	    "sound-off": 0,
	    "sound-on": 1
	},
        "on-click": "$HOME/.config/hypr/scripts/toggle-mute",
        "on-click-right": "footclient -e wiremix",
    },
    "mpris": {
	"format": "{status_icon} {player_icon} {dynamic}",
	"format-stopped": "",
	"player-icons": {
	    "default": "",
	    "mpv": "🎵",
	    "spotify": "",
	    "vlc": "󰕼",
	},
	"status-icons": {
	    "playing": "⏸",
	    "paused": "▶" // Icons reversed to match action, not state
	},
	"ignored-players": ["firefox", "librewolf", "freetube", "chromium"],
	"interval": 1,    // in seconds
	"dynamic-order": ["title", "position", "length"],
	"dynamic-importance-order": ["title", "position", "length"]
    },    
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %d %b %R}"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈁",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid}",
        "on-click": "footclient -e nmtui",
        "format-icons": ["󰤯","󰤟","󰤢","󰤢","󰤨"]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/power": {
        "format" : "⏻",
	"tooltip": true,
	"menu": "on-click",
	"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
	"menu-actions": {
	    "shutdown": "systemctl poweroff",
	    "reboot": "reboot",
	    "suspend": "systemctl suspend",
	    "hibernate": "systemctl hibernate"
	}
    },
    "bluetooth": {
	"format-connected": " {num_connections} connected",
	"format-disabled": "󰂲",
	"format-disconnected": "",
	"tooltip": true,
	"tooltip-format": "No connected devices",
	"tooltip-format-disabled": "Bluetooth disabled",
	"tooltip-format-connected": "{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}",
	"on-click-right": "footclient -e bluetui",
	"on-click": "$HOME/.config/waybar/bluetooth.sh"
    }
}
