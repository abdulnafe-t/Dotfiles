#!/usr/bin/bash
set -euo pipefail

BUILD_DIR="$HOME/Etc/Programs/emacs-build"
C_CODE_DIR="$HOME/Etc/Programs/emacs-c-code"

cd "$BUILD_DIR"
[[ -d src/emacs-git ]] && git -C src/emacs-git clean -fdx
makepkg -si "$@"

cd "$BUILD_DIR/src/emacs-git"
rm "$C_CODE_DIR" -rf
mkdir -p "$C_CODE_DIR"
git archive --format=tar HEAD -- src/*.c src/*.h | tar xf - --directory="$C_CODE_DIR" --strip-components=1
