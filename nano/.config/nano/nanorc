include /usr/share/nano-syntax-highlighting/*.nanorc

extendsyntax Lisp color cyan "(^|[[:space:]]);.*"
extendsyntax Lisp color green "(^|[[:space:]]):[[:alpha:]]*"
extendsyntax Lisp color normal "\("

set linenumbers
set speller "hunspell -x -c"
set tabstospaces
set tabsize 6
set constantshow
set indicator
set minibar
set magic
set spotlightcolor bold,black,#fcb
set boldtext
